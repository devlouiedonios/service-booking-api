{
  "name": "service-booking-api",
  "version": "1.0.0",
  "description": "Backend API for managing service bookings, authentication, search, pagination, sorting, and booking status updates.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest --watch"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "express",
    "postgresql",
    "prisma",
    "rest-api"
  ],
  "author": "Louie M. Donios",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "vitest": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
